# ---------------------------------------------------
# Server
# ---------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------
# Database
# ---------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017/mydukan

# ---------------------------------------------------
# Auth
# ---------------------------------------------------
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# ---------------------------------------------------
# Affiliate config
# ---------------------------------------------------
# Your Amazon Associates tracking ID, e.g. "mydukan-21"
AMAZON_AFFILIATE_TAG=INSERT_AFFILIATE_TAG_HERE
# Amazon marketplace domain used to build buy links (amazon.in, amazon.com, ...)
AMAZON_DOMAIN=amazon.in

# ---------------------------------------------------
# Amazon Product Advertising API (PA-API 5.0)
# Required only for the "Quick Add by URL/ASIN" feature.
# You must have an approved Associates account with the PA-API enabled.
# Docs: https://webservices.amazon.com/paapi5/documentation/
# ---------------------------------------------------
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_PARTNER_TAG=
PAAPI_HOST=webservices.amazon.in
PAAPI_REGION=eu-west-1
